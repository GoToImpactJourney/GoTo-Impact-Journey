<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#078b43">
<title>GoTo Impact Journey | Platform CSR UMKM</title>
<style>
:root{--green:#078b43;--green2:#13a653;--dark:#075b32;--mint:#eaf6ee;--mint2:#f4faf5;--ink:#18251d;--muted:#647269;--line:#dce9df;--white:#fff;--gold:#f0c84b;--shadow:0 12px 30px rgba(10,74,39,.07)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f8faf8;color:var(--ink);font-family:Inter,"Plus Jakarta Sans",Arial,sans-serif;line-height:1.5}button,input,select,textarea{font:inherit}button{cursor:pointer}a{color:inherit}.wrap{width:min(1160px,calc(100% - 36px));margin:auto}.topline{height:7px;background:linear-gradient(90deg,var(--dark),var(--green2),#a6dcb7)}
header{background:rgba(255,255,255,.94);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10;backdrop-filter:blur(12px)}.nav{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none}.logo{width:43px;height:43px;border-radius:14px;background:var(--green);color:#fff;display:grid;place-items:center;font-weight:900;font-size:18px;letter-spacing:-1px;box-shadow:0 6px 14px #078b4326}.brandname{font-weight:900;letter-spacing:-.6px;font-size:20px}.brandname span{color:var(--green)}.tagline{font-size:11px;color:var(--muted);margin-top:1px}.navright{display:flex;align-items:center;gap:10px}.demo-pill{font-size:11px;font-weight:800;color:var(--dark);background:var(--mint);border:1px solid #cde6d4;border-radius:999px;padding:7px 11px}.role-select{max-width:220px;border:1px solid var(--line);background:white;padding:10px 12px;border-radius:12px;font-size:12px;font-weight:700;color:var(--ink)}
.hero{position:relative;overflow:hidden;background:linear-gradient(115deg,#063e25 0%,#087a3b 55%,#12a352 100%);color:#fff;padding:54px 0 48px}.hero:before,.hero:after{content:"";position:absolute;border-radius:50%;pointer-events:none}.hero:before{width:380px;height:380px;border:1px solid #ffffff22;right:-100px;top:-180px;box-shadow:0 0 0 24px #ffffff08,0 0 0 48px #ffffff06}.hero:after{width:260px;height:260px;background:#ffffff08;right:17%;bottom:-220px}.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:32px;position:relative;z-index:1}.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:2px;font-weight:900;color:#b7ebc7}.hero h1{font-size:clamp(32px,4.5vw,52px);line-height:1.06;letter-spacing:-1.8px;margin:10px 0 14px;max-width:680px}.hero h1 span{color:#a6e6b8}.hero p{color:#e2f4e7;max-width:580px;font-size:14px;margin:0}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.btn{border:0;border-radius:12px;padding:11px 16px;font-weight:800;font-size:12px;transition:.2s;display:inline-flex;align-items:center;justify-content:center;gap:8px}.btn:hover{transform:translateY(-1px)}.btn-primary{background:var(--green);color:#fff;box-shadow:0 5px 12px #078b4320}.btn-white{background:#fff;color:var(--dark)}.btn-ghost{background:#ffffff14;color:#fff;border:1px solid #ffffff40}.btn-outline{background:#fff;color:var(--green);border:1px solid var(--line)}.hero-img-box{background:#ffffff12;border:1px solid #ffffff35;border-radius:24px;padding:16px;backdrop-filter:blur(6px);text-align:center}.hero-img-box img{width:100%;height:auto;max-height:240px;object-fit:cover;border-radius:14px;box-shadow:0 8px 20px rgba(0,0,0,.2)}.hero-card{background:#ffffff12;border:1px solid #ffffff35;border-radius:24px;padding:22px;backdrop-filter:blur(6px)}.hero-card .smallcap{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#c8efd3;font-weight:900}.hero-card h3{font-size:22px;margin:8px 0}.hero-card p{font-size:12px}.steps-mini{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:18px}.steps-mini div{background:#ffffff12;border:1px solid #ffffff1d;border-radius:12px;padding:11px 8px;font-size:10px;color:#effff2}.steps-mini strong{display:block;font-size:17px;color:#fff}
main{padding:30px 0 60px}.notice{display:flex;gap:11px;align-items:flex-start;padding:13px 15px;border:1px solid #d8eadc;border-radius:14px;background:#f0f8f2;color:#3d5946;font-size:12px;margin-bottom:22px}.notice b{color:var(--dark)}.notice-icon{width:26px;height:26px;flex:0 0 26px;border-radius:8px;background:#d9f0df;color:var(--green);display:grid;place-items:center;font-weight:900}.tabs{display:flex;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:12px;margin-bottom:24px}.tab{background:transparent;border:1px solid transparent;padding:10px 13px;border-radius:11px;color:#65736a;font-size:12px;font-weight:800}.tab.active{background:var(--green);color:white;box-shadow:0 6px 14px #078b4320}.panel{display:none}.panel.active{display:block;animation:fade .25s ease}@keyframes fade{from{opacity:.4;transform:translateY(4px)}to{opacity:1;transform:none}}.section-head{display:flex;justify-content:space-between;align-items:end;gap:18px;margin-bottom:18px}.section-head h2{font-size:clamp(23px,3vw,31px);letter-spacing:-.8px;line-height:1.15;margin:5px 0}.section-head p{font-size:12px;color:var(--muted);margin:0;max-width:650px}.kicker{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--green);font-weight:900}.grid{display:grid;gap:16px}.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}.grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}.grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;box-shadow:var(--shadow);min-width:0}.card h3{font-size:15px;margin:0 0 8px;letter-spacing:-.2px}.card p{font-size:12px;color:var(--muted);margin:0}.card-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}.iconbox{width:38px;height:38px;border-radius:12px;background:var(--mint);color:var(--green);display:grid;place-items:center;font-size:18px;flex:0 0 auto}.muted{color:var(--muted)}.small{font-size:11px}.field{display:flex;flex-direction:column;gap:6px;margin-bottom:13px}.field label{font-size:11px;font-weight:800;color:#425348}.field input,.field select,.field textarea{width:100%;border:1px solid #d7e3da;background:#fbfdfb;border-radius:10px;padding:11px 12px;font-size:12px;color:var(--ink);outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px #078b4315}.field textarea{min-height:86px;resize:vertical}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}.checkline{display:flex;gap:9px;align-items:flex-start;font-size:11px;color:#53645a;margin:12px 0}.checkline input{margin-top:3px;accent-color:var(--green)}.divider{height:1px;background:#edf2ee;margin:16px 0}.status{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:99px;background:var(--mint);color:var(--dark);font-size:10px;font-weight:900}.status:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--green)}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.stat{padding:16px;border:1px solid var(--line);border-radius:16px;background:#fff}.stat span{display:block;color:var(--muted);font-size:10px;font-weight:800}.stat strong{display:block;font-size:27px;letter-spacing:-1px;color:var(--dark);margin:3px 0}.stat small{font-size:10px;color:var(--muted)}.progress-track{height:8px;background:#eaf0eb;border-radius:99px;overflow:hidden;margin:8px 0}.progress-fill{height:100%;background:linear-gradient(90deg,var(--green),#78c88e);border-radius:99px;transition:width .3s}.phase{border:1px solid var(--line);border-radius:15px;overflow:hidden;margin-bottom:12px}.phase-head{background:#f0f8f2;padding:12px 15px;display:flex;justify-content:space-between;align-items:center;gap:10px}.phase-head strong{font-size:12px}.phase-head span{font-size:10px;color:var(--muted)}.mission{display:flex;gap:11px;padding:13px 15px;border-top:1px solid #edf2ee;align-items:flex-start}.mission input{accent-color:var(--green);margin-top:3px}.mission strong{font-size:12px;display:block}.mission p{font-size:11px;margin:3px 0 0;color:var(--muted)}.mission.done strong{text-decoration:line-through;color:#78877c}.pill-row{display:flex;flex-wrap:wrap;gap:8px}.choice{border:1px solid var(--line);background:#fff;padding:11px 12px;border-radius:12px;font-size:11px;font-weight:800;color:#526259;text-align:left}.choice.selected{border-color:var(--green);background:var(--mint);color:var(--dark);box-shadow:inset 0 0 0 1px var(--green)}.choice small{display:block;font-weight:500;color:var(--muted);margin-top:3px}.empty{padding:25px;text-align:center;border:1px dashed #cdded1;border-radius:14px;color:var(--muted);font-size:12px;background:#fbfdfb}.table-wrap{overflow:auto}table{border-collapse:collapse;width:100%;font-size:11px}th,td{text-align:left;padding:11px 10px;border-bottom:1px solid #edf2ee;white-space:nowrap}th{color:#526259;font-size:10px;text-transform:uppercase;letter-spacing:.5px;background:#f6faf7}.badge-live{font-size:9px;letter-spacing:.6px;font-weight:900;background:#e2f4e7;color:var(--dark);border:1px solid #cde6d4;padding:5px 8px;border-radius:7px}.callout{padding:13px 15px;background:#fff9e8;border:1px solid #f1e3b5;border-radius:13px;color:#6b5b2c;font-size:11px}.message{border-radius:12px;padding:12px;background:#f2f8f3;margin-bottom:9px;font-size:11px}.message strong{display:block;margin-bottom:4px}.message.reply{margin-left:18px;background:#fff;border:1px solid var(--line)}.hidden{display:none!important}.toast{position:fixed;bottom:18px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#143d25;color:#fff;padding:12px 17px;border-radius:12px;font-size:12px;font-weight:700;box-shadow:var(--shadow);z-index:50;transition:.25s}.toast.show{opacity:1;transform:translate(-50%,0)}footer{background:#fff;border-top:1px solid var(--line);padding:24px 0;color:var(--muted);font-size:11px}.footer-inner{display:flex;justify-content:space-between;gap:18px;align-items:center}.footer-brand{font-weight:900;color:var(--dark)}.dots{position:fixed;pointer-events:none;z-index:-1;right:-35px;bottom:-35px;width:220px;height:220px;opacity:.25;background-image:radial-gradient(#9fcfac 2px,transparent 2px);background-size:18px 18px;mask-image:radial-gradient(circle,black,transparent 70%)}
@media(max-width:850px){.hero-grid{grid-template-columns:1fr}.hero-card,.hero-img-box{max-width:540px}.grid-4,.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.grid-3{grid-template-columns:repeat(2,minmax(0,1fr))}.nav{padding:12px 0;align-items:flex-start}.navright{align-items:flex-end;flex-direction:column}.role-select{max-width:190px}}
@media(max-width:560px){.wrap{width:min(100% - 24px,1160px)}.nav{min-height:unset}.brandname{font-size:16px}.tagline{font-size:9px}.logo{width:37px;height:37px}.demo-pill{display:none}.role-select{max-width:150px;font-size:10px;padding:8px}.hero{padding:38px 0}.hero h1{font-size:37px}.hero-card,.hero-img-box{padding:17px}.section-head{align-items:flex-start;flex-direction:column}.grid-2,.grid-3,.grid-4,.stats{grid-template-columns:1fr}.field-row{grid-template-columns:1fr;gap:0}.card{padding:16px}.footer-inner{align-items:flex-start;flex-direction:column}.steps-mini{grid-template-columns:repeat(3,1fr)}}
@media print{header,.hero-actions,.tabs,.btn,footer{display:none!important}.panel{display:block!important;page-break-inside:avoid}.hero{background:#087a3b!important;print-color-adjust:exact}.card,.stat{box-shadow:none}}
</style>
</head>
<body>
<div class="topline"></div>
<header><div class="wrap nav">
  <a href="#top" class="brand"><div class="logo">go</div><div><div class="brandname">GoTo <span>Impact Journey</span></div><div class="tagline">Platform Pendampingan & Evaluasi CSR UMKM</div></div></a>
  <div class="navright"><span class="demo-pill">PORTAL AKTIF</span><select id="roleSelect" class="role-select" aria-label="Pilih tampilan pengguna"><option value="umkm">Tampilan Mitra UMKM</option><option value="mentor">Tampilan Mentor Pendamping</option><option value="admin">Tampilan Admin CSR</option></select></div>
</div></header>
<section class="hero" id="top"><div class="wrap hero-grid">
  <div><div class="eyebrow">Pemberdayaan UMKM Berkelanjutan</div><h1>Ilmu yang dipelajari.<br><span>Aksi yang dijalani.</span></h1><p>Ruang pendampingan terintegrasi 90 hari untuk membantu mitra UMKM mempraktikkan materi pelatihan, berkonsultasi dengan mentor ahli, dan memantau perkembangan usaha secara real-time.</p><div class="hero-actions"><button class="btn btn-white" onclick="goTab('journey')">Mulai perjalanan <span>→</span></button><button class="btn btn-ghost" onclick="goTab('dashboard')">Lihat laporan dampak</button></div></div>
  <div class="hero-img-box"><img src="https://encrypted-tbn0.gstatic.com/images?t=q=tbn:ANd9GcQHtPwvZxrZcP2lgIRbHmUHAbAReH4wqGEXuUOH0X6mLQ&s=10" alt="GoTo Impact Journey UMKM"></div>
</div></section>
<main class="wrap">
<div class="notice"><div class="notice-icon">i</div><div><b>Sistem Aktif:</b> Seluruh data partisipan, survei berkala, dan rekapitulasi penugasan dikelola secara terpusat untuk memastikan efektivitas program pemberdayaan UMKM GoTo.</div></div>
<div class="tabs" role="tablist"><button class="tab active" data-tab="journey" onclick="goTab('journey')">01 · Perjalanan Mitra</button><button class="tab" data-tab="survey" onclick="goTab('survey')">02 · Survei & Check-in</button><button class="tab" data-tab="mentor" onclick="goTab('mentor')">03 · Pendampingan Mentor</button><button class="tab" data-tab="dashboard" onclick="goTab('dashboard')">04 · Dashboard CSR</button></div>

<section id="panel-journey" class="panel active">
 <div class="section-head"><div><div class="kicker">Modul 01 · Mitra UMKM</div><h2>Perjalanan praktik 90 hari</h2><p>Pilih kendala utama usaha, jalankan misi kecil secara terstruktur, dan konsultasikan hambatan langsung kepada mentor.</p></div><span class="status" id="journeyStatus">Perjalanan dimulai</span></div>
 <div class="grid grid-2">
  <div class="card"><div class="card-head"><div class="iconbox">◎</div><div><h3>Profil partisipan</h3><p>Gunakan kode unik partisipan untuk sinkronisasi data.</p></div></div>
   <div class="field"><label for="participantCode">Kode peserta</label><input id="participantCode" maxlength="24" placeholder="Contoh: UMKM-JKT-01" value="UMKM-JKT-01" oninput="syncParticipantCode(this.value)"></div>
   <div class="field"><label for="programName">Program yang diikuti</label><select id="programName"><option>Pojok Belajar</option><option>KOMPAG</option></select></div>
   <div class="field"><label for="region">Wilayah</label><select id="region"><option>Jakarta</option><option>Makassar</option><option>Malang</option><option>Sukabumi</option><option>Serang</option><option>Wilayah lainnya</option></select></div>
   <div class="field"><label>Pilih kendala utama usaha</label><div class="grid grid-2" id="needChoices"><button type="button" class="choice selected" data-need="keuangan" onclick="chooseNeed('keuangan',this)">▤ Pencatatan keuangan<small>Catat pemasukan & pengeluaran</small></button><button type="button" class="choice" data-need="promosi" onclick="chooseNeed('promosi',this)">↗ Promosi digital<small>Perluas jangkauan online</small></button><button type="button" class="choice" data-need="operasional" onclick="chooseNeed('operasional',this)">◷ Operasional usaha<small>Manajemen stok & alur kerja</small></button><button type="button" class="choice" data-need="pelanggan" onclick="chooseNeed('pelanggan',this)">♡ Layanan pelanggan<small>Kepuasan & relasi pembeli</small></button></div></div>
   <label class="checkline"><input id="consent" type="checkbox" checked><span>Saya menyetujui pengumpulan data perkembangan usaha ini digunakan untuk evaluasi program pemberdayaan dan peningkatan layanan pendampingan.</span></label>
   <button class="btn btn-primary" onclick="saveProfile()">Simpan & sinkronkan profil →</button>
  </div>
  <div class="card"><div class="card-head"><div class="iconbox">↗</div><div><h3>Progres misi aktif</h3><p>Penyelarasan data otomatis tersimpan di perangkat.</p></div></div><div style="display:flex;align-items:end;justify-content:space-between;gap:12px"><div><div style="font-size:34px;font-weight:900;color:var(--dark);letter-spacing:-1px" id="progressNumber">0%</div><div class="small muted">Misi selesai</div></div><span class="status" id="missionCount">0 dari 6 misi</span></div><div class="progress-track"><div class="progress-fill" id="mainProgress" style="width:0%"></div></div><p class="small">Centang misi setelah tahapan selesai dijalankan dalam operasional harian usaha.</p><div class="divider"></div><div class="grid grid-3"><div><div class="kicker">Fase 1</div><strong>Hari 1–30</strong><p class="small">Mulai praktik</p></div><div><div class="kicker">Fase 2</div><strong>Hari 31–60</strong><p class="small">Konsistensi</p></div><div><div class="kicker">Fase 3</div><strong>Hari 61–90</strong><p class="small">Evaluasi hasil</p></div></div></div>
 </div>
 <div style="margin-top:18px"><div class="section-head"><div><div class="kicker">Daftar Misi</div><h2 id="missionTitle">Kendala: Pencatatan keuangan</h2><p id="missionIntro">Tugas praktis yang dirancang agar langsung bisa diterapkan pada usaha.</p></div></div><div id="missionList"></div></div>
</section>

<section id="panel-survey" class="panel">
 <div class="section-head"><div><div class="kicker">Modul 02 · Evaluasi berkala</div><h2>Survei awal, check-in, dan survei akhir</h2><p>Pantau perkembangan indikator usaha dari hari ke-0 hingga hari ke-90 menggunakan kode partisipan yang sama.</p></div><span class="badge-live">PORTAL RESMI</span></div>
 <div class="grid grid-2">
  <div class="card"><div class="card-head"><div class="iconbox">▤</div><div><h3>Formulir survei</h3><p>Data terhubung otomatis dengan profil partisipan.</p></div></div>
   <div class="field"><label for="surveyCodeDisplay">Kode peserta (Sinkron)</label><input id="surveyCodeDisplay" readonly style="background:#f0f5f1;font-weight:800;" value="UMKM-JKT-01"></div>
   <div class="field"><label for="surveyStage">Tahapan evaluasi</label><select id="surveyStage"><option value="awal">Survei awal · Hari ke-0</option><option value="30">Check-in · Hari ke-30</option><option value="60">Check-in · Hari ke-60</option><option value="akhir">Survei akhir · Hari ke-90</option></select></div>
   <div class="field"><label for="applySkill">Apakah Anda telah menerapkan materi pelatihan?</label><select id="applySkill"><option value="">Pilih jawaban</option><option value="ya">Ya, sudah diterapkan sepenuhnya</option><option value="sebagian">Sebagian diterapkan</option><option value="belum">Belum</option></select></div>
   <div class="field-row"><div class="field"><label for="monthlyRevenue">Omzet bulanan rata-rata (Rp)</label><input id="monthlyRevenue" type="number" min="0" placeholder="Contoh: 7500000"></div><div class="field"><label for="skillConfidence">Keyakinan penerapan materi (1–5)</label><select id="skillConfidence"><option value="">Pilih skor</option><option value="1">1 · Belum yakin</option><option value="2">2</option><option value="3">3 · Cukup yakin</option><option value="4">4</option><option value="5">5 · Sangat yakin</option></select></div></div>
   <div class="field"><label for="surveyNote">Catatan perkembangan usaha (opsional)</label><textarea id="surveyNote" placeholder="Tuliskan capaian atau kendala yang dihadapi..."></textarea></div>
   <button class="btn btn-primary" onclick="saveSurvey()">Kirim hasil evaluasi →</button>
  </div>
  <div class="card"><div class="card-head"><div class="iconbox">✓</div><div><h3>Riwayat evaluasi partisipan</h3><p>Rekapitulasi entri data berdasarkan kode aktif.</p></div></div><div id="surveyHistory"><div class="empty">Belum ada riwayat survei tersimpan.</div></div><div class="callout" style="margin-top:14px">Informasi omzet bersifat konfidensial dan hanya ditampilkan dalam bentuk agregat untuk laporan dampak CSR.</div></div>
 </div>
</section>

<section id="panel-mentor" class="panel">
 <div class="section-head"><div><div class="kicker">Modul 03 · Konsultasi</div><h2>Ruang konsultasi mentor ahli</h2><p>Konsultasikan kendala operasional secara langsung kepada mentor pendamping untuk mendapatkan solusi cepat.</p></div><span class="status">Sesi aktif</span></div>
 <div class="grid grid-2">
  <div class="card"><div class="card-head"><div class="iconbox">✉</div><div><h3>Ajukan pertanyaan</h3><p>Kirimkan kendala spesifik yang Anda hadapi di lapangan.</p></div></div><div class="field"><label for="questionTopic">Topik konsultasi</label><select id="questionTopic"><option>Pencatatan keuangan</option><option>Promosi digital</option><option>Operasional usaha</option><option>Layanan pelanggan</option><option>Lainnya</option></select></div><div class="field"><label for="questionText">Pesan / kendala</label><textarea id="questionText" placeholder="Contoh: Bagaimana cara terbaik menghitung HPP produk makanan saya?"></textarea></div><button class="btn btn-primary" onclick="sendQuestion()">Kirim ke mentor →</button></div>
  <div class="card"><div class="card-head"><div class="iconbox">☷</div><div><h3>Riwayat konsultasi & respons</h3><p>Daftar konsultasi beserta catatan tindak lanjut mentor.</p></div></div><div id="questionHistory"><div class="empty">Belum ada pertanyaan terkirim.</div></div></div>
 </div>
 <div class="card" style="margin-top:16px"><div class="card-head"><div class="iconbox">♧</div><div><h3>Panel pemantauan mentor</h3><p>Ringkasan aktivitas penanganan konsultasi masuk.</p></div></div><div id="mentorSummary" class="grid grid-3"></div></div>
</section>

<section id="panel-dashboard" class="panel">
 <div class="section-head"><div><div class="kicker">Modul 04 · Laporan & Monitoring CSR</div><h2>Dashboard evaluasi dampak program</h2><p>Analisis komprehensif tingkat adopsi keterampilan, penyelesaian misi, dan sebaran wilayah mitra binaan.</p></div><button class="btn btn-outline" onclick="exportCSV()">↓ Ekspor laporan CSV</button></div>
 <div id="dashboardWarning" class="callout hidden" style="margin-bottom:16px;background:#fdf2f2;border-color:#f5c6cb;color:#721c24;"><b>Perhatian Metodologis:</b> Jumlah responden saat ini masih terbatas. Hindari penarikan kesimpulan kausal mutlak terhadap perubahan omzet sebelum siklus 90 hari selesai secara menyeluruh.</div>
 <div class="stats" id="dashboardStats"></div>
 <div class="grid grid-2" style="margin-top:16px">
  <div class="card"><div class="card-head"><div class="iconbox">▥</div><div><h3>Kelengkapan evaluasi</h3><p>Persentase partisipan dengan data survei lengkap.</p></div></div><div id="completionSummary"></div></div>
  <div class="card"><div class="card-head"><div class="iconbox">⌖</div><div><h3>Jangkauan wilayah</h3><p>Sebaran geografis mitra dampingan program.</p></div></div><div id="regionSummary"></div></div>
 </div>
 <div class="card" style="margin-top:16px"><div class="card-head"><div class="iconbox">▤</div><div><h3>Data terpusat program</h3><p>Entri data real-time yang tersimpan pada sistem.</p></div></div><div class="table-wrap" id="dataTable"></div><div class="divider"></div><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn btn-outline" onclick="loadDemo()">Muat sampel data awal</button><button class="btn btn-outline" onclick="clearDemo()">Reset seluruh data</button></div></div>
 <p class="small muted" style="margin-top:12px">Catatan metodologis: Platform ini menyediakan instrumen pemantauan terstandar untuk mengukur efektivitas intervensi pelatihan terhadap kemandirian usaha mikro.</p>
</section>
</main>
<footer><div class="wrap footer-inner"><div><div class="footer-brand">GoTo Impact Journey</div><div>Platform Pemberdayaan & Evaluasi CSR UMKM</div></div><div>ZERO BARRIERS, MORE OPPORTUNITIES. <br><span class="small">Go Together, Go Far · Inisiatif Strategis Pengembangan Ekosistem UMKM.</span></div></div></footer>
<div class="dots"></div><div id="toast" class="toast" role="status" aria-live="polite"></div>
<script>
const STORE='gotoImpactJourney_v2';
const defaultState={profile:{code:'UMKM-JKT-01',program:'Pojok Belajar',region:'Jakarta',need:'keuangan'},missions:{},surveys:[],questions:[]};
let state=loadState();let selectedNeed=state.profile.need||'keuangan';
const missionSets={
 keuangan:{title:'Kendala: Pencatatan keuangan',intro:'Bangun kedisiplinan pencatatan dan analisis arus kas usaha secara berkala.',phases:[{name:'Fase 1 · Mulai praktik',range:'Hari 1–30',items:[['pisah-uang','Pisahkan keuangan pribadi dan usaha.','Gunakan rekening atau wadah terpisah untuk menghindari percampuran dana.'],['catat-harian','Lakukan pencatatan arus kas harian.','Catat seluruh transaksi masuk dan keluar secara tertib.']]},{name:'Fase 2 · Konsistensi',range:'Hari 31–60',items:[['kelompok-biaya','Klasifikasikan pos pengeluaran usaha.','Pisahkan biaya bahan baku, operasional, dan pemasaran.'],['hitung-laba','Hitung laba bersih secara berkala.','Lakukan rekapitulasi laba mingguan.']]},{name:'Fase 3 · Evaluasi hasil',range:'Hari 61–90',items:[['ringkasan-bulanan','Susun laporan ringkasan bulanan.','Evaluasi total omzet dan efisiensi biaya.'],['rencana-perbaikan','Terapkan strategi efisiensi baru.','Ambil keputusan bisnis berdasarkan data pembukuan.']]}]},
 promosi:{title:'Kendala: Promosi digital',intro:'Optimalkan jangkauan pasar melalui strategi pemasaran digital yang konsisten.',phases:[{name:'Fase 1 · Persiapan',range:'Hari 1–30',items:[['pilih-produk','Tentukan produk unggulan utama.','Fokuskan promosi pada produk dengan margin terbaik.'],['foto-produk','Hasilkan konten visual produk berkualitas.','Pastikan pencahayaan dan deskripsi produk jelas.']]},{name:'Fase 2 · Eksekusi',range:'Hari 31–60',items:[['jadwal-promosi','Buat kalender konten promosi rutin.','Tentukan jadwal posting di media sosial atau marketplace.'],['uji-pesan','Eksplorasi sudut pandang penawaran unik.','Amati respons audiens terhadap materi promosi.']]},{name:'Fase 3 · Evaluasi',range:'Hari 61–90',items:[['analisis-respon','Evaluasi interaksi dan konversi calon pembeli.','Catat materi promosi yang paling diminati.'],['skala-strategi','Fokuskan anggaran atau tenaga pada kanal efektif.','Tingkatkan konsistensi promosi digital.']]}]},
 operasional:{title:'Kendala: Operasional usaha',intro:'Tingkatkan efisiensi kerja melalui manajemen alur dan persediaan yang rapi.',phases:[{name:'Fase 1 · Pemetaan',range:'Hari 1–30',items:[['alur-kerja','Petakan tahapan operasional harian.','Identifikasi titik hambatan dalam proses produksi.'],['stok-opname','Lakukan pencatatan inventaris awal.','Ketahui kepastian jumlah bahan baku yang tersedia.']]},{name:'Fase 2 · Standardisasi',range:'Hari 31–60',items:[['jadwal-stok','Terapkan jadwal pengecekan stok berkala.','Cegah kehabisan bahan baku penting.'],['eliminasi-pemborosan','Kurangi waktu tunggu atau bahan terbuang.','Optimalkan tata letak tempat usaha.']]},{name:'Fase 3 · Peningkatan',range:'Hari 61–90',items:[['uji-standar','Uji coba prosedur kerja baru.','Nilai peningkatan kecepatan pelayanan.'],['evaluasi-operasional','Dokumentasikan SOP sederhana untuk usaha.','Pastikan kualitas operasional terjaga konsisten.']]}]},
 pelanggan:{title:'Kendala: Layanan pelanggan',intro:'Perkuat loyalitas pembeli melalui standar komunikasi dan penanganan yang prima.',phases:[{name:'Fase 1 · Pemahaman',range:'Hari 1–30',items:[['analisis-keluhan','Catat pertanyaan atau kendala pelanggan tersering.','Identifikasi area pelayanan yang perlu ditingkatkan.'],['standar-komunikasi','Susun template balasan cepat yang ramah.','Pastikan informasi produk dan harga akurat.']]},{name:'Fase 2 · Implementasi',range:'Hari 31–60',items:[['respon-cepat','Tingkatkan kecepatan tanggap pesan pembeli.','Berikan pelayanan yang solutif.'],['tanya-ulasan','Minta ulasan atau masukan dari pelanggan setia.','Gunakan masukan untuk evaluasi kualitas.']]},{name:'Fase 3 · Loyalitas',range:'Hari 61–90',items:[['program-khusus','Berikan apresiasi kepada pelanggan berulang.','Bangun hubungan jangka panjang.'],['evaluasi-layanan','Tinjau tingkat kepuasan pelanggan secara keseluruhan.','Pastikan standar pelayanan terus meningkat.']]}]}
};
function loadState(){try{const v=JSON.parse(localStorage.getItem(STORE));return v?{...defaultState,...v,profile:{...defaultState.profile,...v.profile}}:structuredClone(defaultState)}catch(e){return structuredClone(defaultState)}}
function persist(){try{localStorage.setItem(STORE,JSON.stringify(state))}catch(e){} renderAll()}
function toast(msg){const el=document.getElementById('toast');el.textContent=msg;el.classList.add('show');clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>el.classList.remove('show'),2500)}
function goTab(name){document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.tab===name));document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id==='panel-'+name));if(name==='dashboard')renderDashboard();if(name==='mentor')renderMentor();window.scrollTo({top:document.querySelector('main').offsetTop-85,behavior:'smooth'})}
document.querySelectorAll('.tab').forEach(b=>b.addEventListener('click',()=>goTab(b.dataset.tab)));
document.getElementById('roleSelect').addEventListener('change',e=>{const r=e.target.value;if(r==='umkm')goTab('journey');if(r==='mentor')goTab('mentor');if(r==='admin')goTab('dashboard')});
function chooseNeed(need,btn){selectedNeed=need;document.querySelectorAll('.choice').forEach(b=>b.classList.toggle('selected',b.dataset.need===need));renderMissions()}
function syncParticipantCode(val){const code=val.trim();document.getElementById('surveyCodeDisplay').value=code||'UMKM-JKT-01';}
function saveProfile(){const code=document.getElementById('participantCode').value.trim();if(!code){toast('Kode peserta wajib diisi.');return}if(!document.getElementById('consent').checked){toast('Persetujuan partisipan wajib dicentang.');return}state.profile={code,program:document.getElementById('programName').value,region:document.getElementById('region').value,need:selectedNeed};persist();toast('Profil dan kode partisipan berhasil disinkronkan.')}
function renderMissions(){const set=missionSets[selectedNeed]||missionSets.keuangan;document.getElementById('missionTitle').textContent=set.title;document.getElementById('missionIntro').textContent=set.intro;const root=document.getElementById('missionList');root.innerHTML='';let total=0,done=0;set.phases.forEach(phase=>{const box=document.createElement('div');box.className='phase';const head=document.createElement('div');head.className='phase-head';head.innerHTML=`<strong>${phase.name}</strong><span>${phase.range}</span>`;box.appendChild(head);phase.items.forEach(item=>{total++;const isDone=!!state.missions[item[0]];if(isDone)done++;const row=document.createElement('label');row.className='mission'+(isDone?' done':'');row.innerHTML=`<input type="checkbox" ${isDone?'checked':''} aria-label="Tandai misi selesai"><div><strong>${item[1]}</strong><p>${item[2]}</p></div>`;row.querySelector('input').addEventListener('change',e=>{state.missions[item[0]]=e.target.checked;persist();toast(e.target.checked?'Misi ditandai selesai.':'Status misi diperbarui.')});box.appendChild(row)});root.appendChild(box)});const pct=total?Math.round(done/total*100):0;document.getElementById('progressNumber').textContent=pct+'%';document.getElementById('missionCount').textContent=`${done} dari ${total} misi`;document.getElementById('mainProgress').style.width=pct+'%';document.getElementById('journeyStatus').textContent=done===total?'Semua misi tuntas':done?'Sedang berjalan':'Perjalanan dimulai'}
function saveSurvey(){const code=document.getElementById('participantCode').value.trim()||state.profile.code;if(!code){toast('Masukkan kode peserta pada modul sebelumnya.');return}const stage=document.getElementById('surveyStage').value;const apply=document.getElementById('applySkill').value;const revenue=document.getElementById('monthlyRevenue').value;const confidence=document.getElementById('skillConfidence').value;if(!apply||!confidence){toast('Pilih tingkat penerapan materi dan skor keyakinan.');return}if(revenue!==''&&Number(revenue)<0){toast('Omzet tidak boleh bernilai negatif.');return}const entry={id:Date.now(),code,stage,apply,revenue:revenue===''?null:Number(revenue),confidence:Number(confidence),note:document.getElementById('surveyNote').value.trim(),date:new Date().toLocaleDateString('id-ID')};state.surveys.push(entry);persist();toast('Data survei berhasil disimpan ke server lokal.');renderSurveys();document.getElementById('monthlyRevenue').value='';document.getElementById('surveyNote').value='';}
function renderSurveys(){const box=document.getElementById('surveyHistory');if(!state.surveys.length){box.innerHTML='<div class="empty">Belum ada riwayat survei tersimpan.</div>';return}box.innerHTML=state.surveys.slice(-4).reverse().map(s=>`<div class="message"><strong>${s.code} · Tahap: ${s.stage.toUpperCase()} (${s.date})</strong>Penerapan: <b>${s.apply}</b> | Keyakinan: <b>${s.confidence}/5</b> ${s.revenue?(' | Omzet: Rp '+Number(s.revenue).toLocaleString('id-ID')):'-'} ${s.note?'<br><em>"'+s.note+'"</em>':''}</div>`).join('')}
function sendQuestion(){const text=document.getElementById('questionText').value.trim();if(!text){toast('Tuliskan pertanyaan atau kendala terlebih dahulu.');return}const q={id:Date.now(),code:state.profile.code,topic:document.getElementById('questionTopic').value,text,reply:'Terima kasih atas pertanyaannya. Mentor akan segera meninjau dan memberikan arahan tindak lanjut dalam 1x24 jam.',date:new Date().toLocaleDateString('id-ID')};state.questions.push(q);persist();document.getElementById('questionText').value='';toast('Pertanyaan berhasil dikirim ke mentor.');renderMentor()}
function renderMentor(){const box=document.getElementById('questionHistory');if(!state.questions.length){box.innerHTML='<div class="empty">Belum ada pertanyaan terkirim.</div>';return}box.innerHTML=state.questions.slice(-4).reverse().map(q=>`<div class="message"><strong>${q.code} · Topik: ${q.topic}</strong>${q.text}<div class="message reply"><strong>Respons Mentor</strong>${q.reply}</div></div>`).join('');const sum=document.getElementById('mentorSummary');sum.innerHTML=`<div class="stat"><span>Total Konsultasi</span><strong>${state.questions.length}</strong><small>Pertanyaan masuk</small></div><div class="stat"><span>Status Layanan</span><strong>Aktif</strong><small>Respon 24 Jam</small></div><div class="stat"><span>Mentor Tugas</span><strong>3 Ahli</strong><small>Siap mendampingi</small></div>`}
function renderDashboard(){const totalSurveys=state.surveys.length;const uniqueCodes=new Set(state.surveys.map(s=>s.code)).size;const completedSurveys=state.surveys.filter(s=>s.stage==='akhir').length;const compRate=totalSurveys?Math.round((completedSurveys/Math.max(1,uniqueCodes))*100):0;const regions={};state.surveys.forEach(s=>{regions[state.profile.region]=(regions[state.profile.region]||0)+1});if(state.profile.region&&!regions[state.profile.region])regions[state.profile.region]=1;const regHtml=Object.keys(regions).length?Object.entries(regions).map(([r,c])=>`<div style="display:flex;justify-content:space-between;font-size:12px;padding:6px 0;border-bottom:1px solid #edf2ee"><span>${r}</span><b>${c} partisipan</b></div>`).join(''):'<div class="empty">Belum ada data wilayah.</div>';document.getElementById('regionSummary').innerHTML=regHtml;const warn=document.getElementById('dashboardWarning');if(totalSurveys<3){warn.classList.remove('hidden')}else{warn.classList.add('hidden')}document.getElementById('dashboardStats').innerHTML=`<div class="stat"><span>Partisipan Unik</span><strong>${uniqueCodes}</strong><small>Kode aktif</small></div><div class="stat"><span>Kelengkapan Survei</span><strong>${compRate}%</strong><small>Tahap akhir</small></div><div class="stat"><span>Total Entri Data</span><strong>${totalSurveys}</strong><small>Pencatatan survei</small></div><div class="stat"><span>Wilayah Aktif</span><strong>${Object.keys(regions).length}</strong><small>Area sebaran</small></div>`;document.getElementById('completionSummary').innerHTML=`<div style="font-size:13px;margin-bottom:8px">Kelengkapan survei awal dan akhir: <b>${compRate}%</b></div><div class="progress-track"><div class="progress-fill" style="width:${compRate}%"></div></div><p class="small muted">Data divalidasi berdasarkan kecocokan kode partisipan.</p>`;const table=document.getElementById('dataTable');if(!state.surveys.length){table.innerHTML='<div class="empty">Belum ada data terekam di sistem.</div>';return}table.innerHTML=`<table><thead><tr><th>Waktu</th><th>Kode Peserta</th><th>Tahap</th><th>Penerapan Materi</th><th>Keyakinan</th><th>Omzet (Rp)</th></tr></thead><tbody>${state.surveys.map(s=>`<tr><td>${s.date}</td><td><b>${s.code}</b></td><td>${s.stage}</td><td>${s.apply}</td><td>${s.confidence}/5</td><td>${s.revenue?Number(s.revenue).toLocaleString('id-ID'):'-'}</td></tr>`).join('')}</tbody></table>`}
function loadDemo(){state.surveys=[{id:1,code:'UMKM-JKT-01',stage:'awal',apply:'sebagian',revenue:5000000,confidence:3,note:'Mulai memisahkan rekening.',date:'10/08/2026'},{id:2,code:'UMKM-JKT-01',stage:'30',apply:'ya',revenue:6200000,confidence:4,note:'Pencatatan harian mulai rutin.',date:'10/09/2026'},{id:3,code:'UMKM-JKT-01',stage:'akhir',apply:'ya',revenue:8000000,confidence:5,note:'Arus kas usaha jauh lebih teratur.',date:'10/10/2026'}];persist();toast('Sampel data berhasil dimuat.');renderDashboard()}
function clearDemo(){state.surveys=[];state.questions=[];state.missions={};persist();toast('Data berhasil direset.');renderDashboard()}
function exportCSV(){if(!state.surveys.length){toast('Tidak ada data untuk diekspor.');return}let csv='Waktu,KodePeserta,Tahap,Penerapan,Keyakinan,Omzet\n'+state.surveys.map(s=>[s.date,s.code,s.stage,s.apply,s.confidence,s.revenue||''].join(',')).join('\n');const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='laporan_goto_impact_journey.csv';a.click();toast('Laporan CSV berhasil diunduh.')}
function renderAll(){renderMissions();renderSurveys();renderMentor()}
renderAll();
</script>
</body>
</html>
